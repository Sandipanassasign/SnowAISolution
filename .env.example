# ==============================================================================
# ServiceNow Credentials
# ==============================================================================
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_USERNAME=your_username
SNOW_PASSWORD=your_password

# OAuth (alternative to basic auth)
SNOW_CLIENT_ID=your_client_id
SNOW_CLIENT_SECRET=your_client_secret

# ==============================================================================
# LLM Configuration
# ==============================================================================
LLM_API_KEY=your_llm_api_key
LLM_API_BASE_URL=https://your-llm-endpoint.internal.bank.com/v1
LLM_MODEL_NAME=claude-opus-4-20250514

# ==============================================================================
# SSL / Proxy Configuration (VDI)
# ==============================================================================
# Path to enterprise CA certificate bundle (.pem file)
# SSL_CERT_FILE=/path/to/enterprise-ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/enterprise-ca-bundle.pem

# Set to "true" to disable SSL verification (LOCAL DEV ONLY)
DISABLE_SSL_VERIFY=false

# Internal proxy (if required)
# HTTP_PROXY=http://proxy.internal.bank.com:8080
# HTTPS_PROXY=http://proxy.internal.bank.com:8080

# ==============================================================================
# SMTP Configuration
# ==============================================================================
SMTP_HOST=smtp.internal.bank.com
SMTP_PORT=25
SMTP_FROM_ADDRESS=servicenow-automation@bank.com

# ==============================================================================
# Application Settings
# ==============================================================================
LOG_LEVEL=INFO
SNOW_POLL_INTERVAL_SECONDS=300

# Set to "true" to test pipeline offline using synthetic data without live credentials
MOCK_MODE=false

# Web Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
